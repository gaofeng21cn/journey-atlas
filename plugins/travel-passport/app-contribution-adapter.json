{
  "schema_version": "opl-package-app-contribution-adapter.v1",
  "reads": {
    "travel.passport.v1#status": {
      "kind": "command",
      "cwd": "package",
      "argv": [
        "node",
        "./app-contribution.mjs"
      ],
      "stdin": "request_json",
      "passthrough": true,
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    "travel.passport.v1#overview": {
      "kind": "command",
      "cwd": "package",
      "argv": [
        "node",
        "./app-contribution.mjs"
      ],
      "stdin": "request_json",
      "passthrough": true,
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    "travel.passport.v1#annual": {
      "kind": "command",
      "cwd": "package",
      "argv": [
        "node",
        "./app-contribution.mjs"
      ],
      "stdin": "request_json",
      "passthrough": true,
      "input_schema": {
        "type": "object",
        "properties": {
          "year": {
            "type": "integer",
            "minimum": 2000,
            "maximum": 2100
          }
        },
        "additionalProperties": false
      }
    },
    "travel.passport.v1#regions": {
      "kind": "command",
      "cwd": "package",
      "argv": [
        "node",
        "./app-contribution.mjs"
      ],
      "stdin": "request_json",
      "passthrough": true,
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    }
  },
  "actions": {
    "travel.passport.v1#runtime.setup": {
      "kind": "command",
      "cwd": "package",
      "argv": [
        "node",
        "./app-contribution.mjs"
      ],
      "stdin": "request_json",
      "passthrough": true,
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    "travel.passport.v1#annual.generate": {
      "kind": "command",
      "cwd": "package",
      "argv": [
        "node",
        "./app-contribution.mjs"
      ],
      "stdin": "request_json",
      "passthrough": true,
      "input_schema": {
        "type": "object",
        "required": [
          "year"
        ],
        "properties": {
          "year": {
            "type": "integer",
            "title": "年份",
            "minimum": 1900,
            "maximum": 2200
          },
          "theme": {
            "type": "string",
            "title": "主题：创造与行走／旅行／创造与AI",
            "enum": [
              "life",
              "travel",
              "creation"
            ],
            "default": "life"
          },
          "style": {
            "type": "string",
            "title": "风格：奶油纸色／午夜航线／蓝色护照",
            "enum": [
              "paper",
              "night",
              "blueprint"
            ],
            "default": "paper"
          },
          "format": {
            "type": "string",
            "title": "形式：单卡／九张故事（朋友圈九宫格）",
            "enum": [
              "single",
              "story"
            ],
            "default": "single"
          },
          "include_planned": {
            "type": "boolean",
            "title": "计入本年度待飞行程"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
