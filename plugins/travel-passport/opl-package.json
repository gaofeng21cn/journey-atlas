{
  "schema_version": "opl.package.v2",
  "identity": {
    "id": "travel-passport",
    "version": "0.2.5",
    "intent": "extension",
    "name": {
      "zh-CN": "Journey Atlas",
      "en-US": "Journey Atlas"
    },
    "summary": {
      "zh-CN": "从旅行记录和 Obsidian 资料生成旅行地图、护照与年度回顾。",
      "en-US": "Build travel maps, passports, and annual reviews from user-owned records and Obsidian."
    },
    "publisher": "gaofeng21cn",
    "icon": "assets/branding/journey-atlas-logo.png",
    "repository": "https://github.com/gaofeng21cn/journey-atlas",
    "routing_summary": {
      "zh-CN": "用 Journey Atlas 读取和维护旅行资料，生成地图并在共享视图中审阅。",
      "en-US": "Use Journey Atlas to maintain travel records, generate maps, and review shared views."
    }
  },
  "dependencies": {
    "opl_base": "^2.0.0",
    "runtimes": [
      {
        "name": "node",
        "version": ">=22"
      }
    ]
  },
  "provides": {
    "skills": [
      {
        "id": "travel-planning",
        "path": "./skills/travel-planning",
        "exposure": "default"
      }
    ],
    "module_ids": [
      "travel.passport.v1"
    ],
    "contribution_handler": {
      "kind": "cli",
      "argv": [
        "node",
        "./app-contribution.mjs"
      ],
      "transport": "stdin_json_stdout_json"
    }
  },
  "ui": {
    "declarative": {
      "views": [
        {
          "id": "travel.passport.status",
          "view_type": "service_status",
          "slot": "settings.section",
          "settings_destination": "resources",
          "title": {
            "zh-CN": "旅行护照状态",
            "en-US": "Travel passport status"
          },
          "data_ref": "travel.passport.v1#status",
          "empty_state": {
            "zh-CN": "尚未读取旅行护照状态",
            "en-US": "Travel passport status has not been read"
          },
          "actions": [
            {
              "id": "travel.passport.setup",
              "label": {
                "zh-CN": "初始化运行环境",
                "en-US": "Prepare runtime"
              },
              "action_ref": "travel.passport.v1#runtime.setup",
              "confirm": true,
              "effect_timing": "immediate"
            }
          ],
          "sort_order": 1000
        },
        {
          "id": "travel.passport.overview",
          "view_type": "list_detail",
          "slot": "settings.section",
          "settings_destination": "resources",
          "title": {
            "zh-CN": "旅行护照总览",
            "en-US": "Travel passport overview"
          },
          "data_ref": "travel.passport.v1#overview",
          "empty_state": {
            "zh-CN": "尚未读取旅行护照总览",
            "en-US": "Travel passport overview has not been read"
          },
          "sort_order": 1001
        },
        {
          "id": "travel.passport.annual",
          "view_type": "list_detail",
          "slot": "settings.section",
          "settings_destination": "resources",
          "title": {
            "zh-CN": "年度总结",
            "en-US": "Year in review"
          },
          "data_ref": "travel.passport.v1#annual",
          "empty_state": {
            "zh-CN": "选择年度、主题、风格与单卡或多卡，生成自己的年度总结",
            "en-US": "Choose a year, theme, style and single card or story"
          },
          "actions": [
            {
              "id": "travel.passport.annual.generate",
              "label": {
                "zh-CN": "制作年度总结",
                "en-US": "Create year in review"
              },
              "action_ref": "travel.passport.v1#annual.generate",
              "confirm": false,
              "effect_timing": "immediate"
            }
          ],
          "sort_order": 1002
        },
        {
          "id": "travel.passport.regions",
          "view_type": "list_detail",
          "slot": "settings.section",
          "settings_destination": "resources",
          "title": {
            "zh-CN": "分区旅行护照",
            "en-US": "Regional travel passports"
          },
          "data_ref": "travel.passport.v1#regions",
          "empty_state": {
            "zh-CN": "尚未读取分区旅行护照",
            "en-US": "Regional travel passports have not been read"
          },
          "sort_order": 1003
        }
      ]
    }
  },
  "distribution": {
    "oci": "ghcr.io/gaofeng21cn/one-person-lab-packages/travel-passport",
    "visibility": "public"
  },
  "host_hints": {
    "codex": {
      "sync_enabled": false
    }
  }
}
