{
  "name": "travel-passport",
  "version": "0.1.1",
  "type": "module",
  "description": "Local-first travel atlas and Flighty-style passport generator",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "geography:check": "node scripts/prepare-open-geography.mjs --check",
    "render": "node scripts/passport.mjs build",
    "render:all": "node scripts/render-all.mjs",
    "outputs:organize": "node scripts/organize-output.mjs",
    "site:build": "node scripts/site.mjs build",
    "site": "node scripts/site.mjs serve",
    "site:check": "node scripts/site.mjs check",
    "site:export": "node scripts/site.mjs export",
    "site:test": "node scripts/check-site.mjs",
    "verify": "node scripts/verify-all.mjs",
    "cities:evidence": "node scripts/rebuild-city-evidence.mjs",
    "mobility:evidence": "node scripts/collect-global-evidence.mjs",
    "build": "node scripts/passport.mjs build",
    "status": "node scripts/passport.mjs status",
    "check:data": "node scripts/passport.mjs check",
    "trace": "node scripts/passport.mjs trace",
    "test": "node --test test/*.test.mjs",
    "update": "node scripts/passport.mjs update",
    "atlas": "node scripts/render-atlas.mjs",
    "atlas:data": "node scripts/atlas-data.mjs",
    "atlas:update": "node scripts/update-atlas.mjs",
    "passport": "node scripts/passport.mjs",
    "infer-placeholders": "node scripts/infer-placeholders.mjs",
    "infer-links": "node scripts/infer-links.mjs",
    "reconstruct:connections": "node scripts/reconstruct-connections.mjs",
    "audit:continuity": "node scripts/audit-node-continuity.mjs",
    "audit:gateways": "node scripts/audit-gateways.mjs",
    "repair:journey-scope": "node scripts/repair-journey-scope.mjs",
    "repair:node-edges": "node scripts/repair-formal-node-edges.mjs",
    "prune:history": "node scripts/prune-history.mjs",
    "prune:cache": "node scripts/prune-cache.mjs",
    "storage": "node scripts/storage.mjs",
    "annual": "node scripts/render-annual.mjs",
    "promote:candidates": "node scripts/promote-verified-candidates.mjs",
    "check": "node scripts/check.mjs",
    "package:sync": "node scripts/materialize_package.mjs",
    "package:check": "node scripts/materialize_package.mjs --check",
    "init:data": "node scripts/source-data-cli.mjs init",
    "import:data": "node scripts/source-data-cli.mjs import"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "i18n-iso-countries": "^7.14.0",
    "pbf": "^5.1.2",
    "playwright": "1.64.0",
    "topojson-client": "3.1.0",
    "tz-lookup": "^6.1.25",
    "world-atlas": "^2.0.2",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "projectName": "Journey Atlas",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gaofeng21cn/journey-atlas.git"
  }
}
