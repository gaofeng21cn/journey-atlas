{
  "name": "travel-passport",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "description": "Agent-native travel atlas with a local CLI and shared OPL review views",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup:dev": "npm --prefix plugins/travel-passport ci",
    "geography:check": "node plugins/travel-passport/scripts/prepare-open-geography.mjs --check",
    "render": "node plugins/travel-passport/scripts/passport.mjs build",
    "render:all": "node plugins/travel-passport/scripts/render-all.mjs",
    "outputs:organize": "node plugins/travel-passport/scripts/organize-output.mjs",
    "site:build": "node plugins/travel-passport/scripts/site.mjs build",
    "site": "node plugins/travel-passport/scripts/site.mjs serve",
    "site:check": "node plugins/travel-passport/scripts/site.mjs check",
    "site:export": "node plugins/travel-passport/scripts/site.mjs export",
    "site:test": "node plugins/travel-passport/scripts/check-site.mjs",
    "verify": "node plugins/travel-passport/scripts/verify-all.mjs",
    "cities:evidence": "node plugins/travel-passport/scripts/rebuild-city-evidence.mjs",
    "mobility:evidence": "node plugins/travel-passport/scripts/collect-global-evidence.mjs",
    "build": "node plugins/travel-passport/scripts/passport.mjs build",
    "status": "node plugins/travel-passport/scripts/passport.mjs status",
    "check:data": "node plugins/travel-passport/scripts/passport.mjs check",
    "trace": "node plugins/travel-passport/scripts/passport.mjs trace",
    "test": "node --test test/*.test.mjs",
    "update": "node plugins/travel-passport/scripts/passport.mjs update",
    "atlas": "node plugins/travel-passport/scripts/render-atlas.mjs",
    "atlas:data": "node plugins/travel-passport/scripts/atlas-data.mjs",
    "atlas:update": "node plugins/travel-passport/scripts/update-atlas.mjs",
    "passport": "node plugins/travel-passport/scripts/passport.mjs",
    "infer-placeholders": "node plugins/travel-passport/scripts/infer-placeholders.mjs",
    "infer-links": "node plugins/travel-passport/scripts/infer-links.mjs",
    "reconstruct:connections": "node plugins/travel-passport/scripts/reconstruct-connections.mjs",
    "audit:continuity": "node plugins/travel-passport/scripts/audit-node-continuity.mjs",
    "audit:gateways": "node plugins/travel-passport/scripts/audit-gateways.mjs",
    "repair:journey-scope": "node plugins/travel-passport/scripts/repair-journey-scope.mjs",
    "repair:node-edges": "node plugins/travel-passport/scripts/repair-formal-node-edges.mjs",
    "prune:history": "node plugins/travel-passport/scripts/prune-history.mjs",
    "prune:cache": "node plugins/travel-passport/scripts/prune-cache.mjs",
    "storage": "node plugins/travel-passport/scripts/storage.mjs",
    "annual": "node plugins/travel-passport/scripts/render-annual.mjs",
    "promote:candidates": "node plugins/travel-passport/scripts/promote-verified-candidates.mjs",
    "check": "node plugins/travel-passport/scripts/check.mjs",
    "package:sync": "node scripts/materialize_package.mjs",
    "package:check": "node scripts/materialize_package.mjs --check",
    "init:data": "node plugins/travel-passport/scripts/source-data-cli.mjs init",
    "import:data": "node plugins/travel-passport/scripts/source-data-cli.mjs import",
    "journey": "node plugins/travel-passport/journey-atlas.mjs",
    "verify:installed": "node scripts/verify-installed-runtime.mjs",
    "review": "node plugins/travel-passport/scripts/render-year-review.mjs"
  },
  "projectName": "Journey Atlas",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gaofeng21cn/journey-atlas.git"
  }
}
